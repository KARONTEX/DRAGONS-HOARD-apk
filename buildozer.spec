[app]
title = Dragons Hoard
package.name = dragonshoard
package.domain = com.jeriko
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 1.0
requirements = python3,kivy,urllib3
orientation = portrait
osx.kivy_version = 2.2.1
fullscreen = 0
android.permissions = INTERNET
android.api = 33
android.minapi = 21
android.ndk = 25b
android.archs = arm64-v8a, armeabi-v7a

[buildozer]
log_level = 2
warn_on_root = 1
